generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Module {
  id          String   @id 
  title       String
  description String?
  department  String?
  workload    Float?
  prereqTree  Json?
  userPlanModules UserPlanModule[]
}

model MajorTemplate {
  id        String   @id @default(cuid())
  majorCode String   @unique
  majorName String
}

model UserPlanModule {
  id          String  @id @default(cuid())
  userId      String
  moduleId    String
  semesterTag String?
  colorTag    String?
  module      Module  @relation(fields: [moduleId], references: [id])
  completed   Boolean @default(false)

}

