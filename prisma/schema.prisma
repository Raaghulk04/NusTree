generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Module {
  id          String   @id 
  title       String
  description String?
  department  String?
  workload    Float?
}

model MajorTemplate {
  id        String   @id @default(cuid())
  majorCode String   @unique
  majorName String
}

model UserPlanModule {
  id          String  @id @default(cuid())
  semesterTag String?
  colorTag    String?
  completed   Boolean @default(false)
}

